{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"slug": "section-reversed",
	"title": "Section (reversed)",
	"blockTypes": [
		"core/group"
	],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--contrast)",
			"text": "var(--wp--preset--color--base)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--base)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary-tint)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--line)"
				}
			}
		}
	}
}