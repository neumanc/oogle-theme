<?xml version="1.0"?>
<ruleset name="Oogle Theme">
	<description>WordPress Coding Standards for Oogle Theme (dev-only; install phpcs + WPCS globally).</description>
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="oogle"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="oogle"/></property>
		</properties>
	</rule>
	<config name="minimum_wp_version" value="7.0"/>
	<config name="testVersion" value="8.1-"/>
</ruleset>
